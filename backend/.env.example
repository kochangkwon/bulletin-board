# Server Configuration
NODE_ENV=development
PORT=3000

# AI 답변 기능 설정
# AI 답변 기능을 활성화하려면 true로 설정
AI_RESPONSE_ENABLED=true

# AI 답변 생성 타임아웃 (밀리초, 기본값: 10000ms = 10초)
AI_RESPONSE_TIMEOUT=10000

# API 재시도 횟수 (기본값: 2)
AI_MAX_RETRY=2

# Google Gemini API
# 발급 방법: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API
# 발급 방법: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Logging
LOG_LEVEL=info
